from abc import ABC,abstractmethod
class account(ABC):
    def __init__(self):
        self.balance = 0 
    def add(self,amount):
        if amount < 0:
            print("Value cannot be negative")
        else:
            self.balance+= amount
    @abstractmethod
    def withdraw(self,amount):
        pass
    @abstractmethod
    def display_balance(self):
        pass
class saving(account):
    def display_balance(self):
        print("Saving acc balance is :",self.balance)
    def withdraw(self,amount):
        if amount > self.balance:
            print("Low balance!")
        else:
            self.balance-=amount
class current(account):
    def __init__(self):
        super().__init__()
        self.overdraft_limit = -1000
    def display_balance(self):
        print("Saving acc balance is :",self.balance)
    def withdraw(self,amount):
        if self.balance - amount < self.overdraft_limit:
            print("Overdraft limit crossed, cannot withdraw!")
            return
        if amount > self.balance:
            print("Low balance!")
        else:
            self.balance-=amount
            

def paybill(account,amount):
    account.withdraw(amount)
